{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["./*.ts", "./order-value-proto/*.ts", "./order-value-proto/v2/*.ts", "./order-value-proto/v3/*.ts", "./order-value-proto/v4/*.ts"]
}
